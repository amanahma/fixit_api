# Copy to .env and fill in. Never commit .env.

# Compose API uses host `db`. Pytest on the host uses 5433 (see README).
DATABASE_URL=postgresql+asyncpg://fixit:fixit@127.0.0.1:5433/fixit
PINCODE_API_BASE_URL=https://api.postalpincode.in
SERVICE_DISTRICTS=New Delhi,Central Delhi,South Delhi,North Delhi,East Delhi,West Delhi
HTTP_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
SQL_ECHO=false
PORT=8000
ENABLE_ERROR_PROBE=false
PINCODE_MAX_RETRIES=2
